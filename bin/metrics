#!/bin/bash
# Poniente Metrics Collector
# Tracks key business metrics over time

set -e

DATA_DIR="${DATA_DIR:-$HOME/.poniente/metrics}"
LOG_FILE="$DATA_DIR/metrics.log"
API_URL="https://api-gilt-xi-28.vercel.app"

mkdir -p "$DATA_DIR"

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG_FILE"; echo "$1"; }

# Collect metrics
collect() {
    local timestamp=$(date -Iseconds)
    
    log "${CYAN}=== Collecting metrics for $timestamp ===${NC}"
    
    # API status
    local api_status=$(curl -s -o /dev/null -w "%{http_code}" "$API_URL/health" 2>/dev/null || echo "0")
    log "API Status: $api_status"
    
    # Latency
    local latency=$(curl -s -o /dev/null -w "%{time_total}" "$API_URL/health" 2>/dev/null || echo "0")
    log "Latency: ${latency}s"
    
    # Check integrations
    local debug=$(curl -s "$API_URL/api/debug" 2>/dev/null)
    local supabase=$(echo "$debug" | grep -o '"supabase":[^,]*' | cut -d':' -f2 || echo "unknown")
    local stripe=$(echo "$debug" | grep -o '"stripe":[^,]*' | cut -d':' -f2 || echo "unknown")
    log "Supabase: $supabase"
    log "Stripe: $stripe"
    
    # Save daily metrics
    echo "$timestamp,$api_status,$latency,$supabase,$stripe" >> "$DATA_DIR/daily.csv"
    
    log "${GREEN}Metrics collected${NC}"
}

# Generate report
report() {
    echo ""
    echo -e "${CYAN}=== Poniente Metrics Report ===${NC}"
    echo ""
    
    if [ -f "$DATA_DIR/daily.csv" ]; then
        local total=$(wc -l < "$DATA_DIR/daily.csv")
        echo "Total data points: $total"
        
        echo ""
        echo "Last 10 entries:"
        tail -10 "$DATA_DIR/daily.csv" | while read line; do
            echo "  $line"
        done
        
        echo ""
        echo "Average latency:"
        awk -F',' '{sum+=$3; count++} END {if(count>0) printf "  %.3fs\n", sum/count}' "$DATA_DIR/daily.csv"
        
        echo ""
        echo "Uptime:"
        local up=$(awk -F',' '$2=="200" {up++} END {if(NR>0) printf "%.1f%%\n", (up/NR)*100}' "$DATA_DIR/daily.csv")
        echo "  $up"
    else
        echo "No data collected yet. Run 'collect' first."
    fi
    
    echo ""
    echo "Log file: $LOG_FILE"
}

# Show trends
trends() {
    echo ""
    echo -e "${CYAN}=== Trends ===${NC}"
    
    if [ -f "$DATA_DIR/daily.csv" ] && [ $(wc -l < "$DATA_DIR/daily.csv") -gt 1 ]; then
        echo ""
        echo "Latency trend (last 7 days):"
        tail -7 "$DATA_DIR/daily.csv" | awk -F',' '{
            split($1, d, "T");
            printf "  %s: %ss\n", d[1], $3
        }'
        
        echo ""
        echo "Integration status:"
        tail -1 "$DATA_DIR/daily.csv" | awk -F',' '{
            printf "  Supabase: %s\n", $4
            printf "  Stripe: %s\n", $5
        }'
    else
        echo "Not enough data for trends."
    fi
}

# Export for graphing
export_csv() {
    local out="${1:-$DATA_DIR/export.csv}"
    cp "$DATA_DIR/daily.csv" "$out"
    echo "Exported to $out"
}

case "${1:-collect}" in
    collect) collect ;;
    report) report ;;
    trends) trends ;;
    export) export_csv "$2" ;;
    *) echo "Usage: $0 {collect|report|trends|export [file]}" ;;
esac
