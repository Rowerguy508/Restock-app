#!/bin/bash
# Poniente Monitoring - Health checks and alerts

set -e

# Configuration
API_URL="https://api-gilt-xi-28.vercel.app"
TELEGRAM_BOT="${TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT="${TELEGRAM_CHAT_ID:-}"
EMAIL_TO="${EMAIL_TO:-}"
LOG_FILE="${LOG_FILE:-$HOME/.poniente/monitor.log}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" | tee -a "$LOG_FILE"; }
warn() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [WARN] $1" | tee -a "$LOG_FILE"; }
err() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" | tee -a "$LOG_FILE"; }

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Send alert
send_alert() {
    local message="$1"
    local severity="$2"  # warning, error, critical
    
    log "Sending alert: $message (severity: $severity)"
    
    # Telegram
    if [ -n "$TELEGRAM_BOT" ] && [ -n "$TELEGRAM_CHAT" ]; then
        curl -s -X POST "https://api.telegram.org/bot$TELEGRAM_BOT/sendMessage" \
            -d "chat_id=$TELEGRAM_CHAT" \
            -d "text=🦞 Poniente Alert ($severity): $message" \
            -d "parse_mode=HTML" 2>/dev/null || true
    fi
    
    # Email (using mail command)
    if [ -n "$EMAIL_TO" ]; then
        echo "$message" | mail -s "[Poniente] $severity: $message" "$EMAIL_TO" 2>/dev/null || true
    fi
}

# Check API health
check_api() {
    log "Checking API health..."
    
    local response
    response=$(curl -s -w "\n%{http_code}" "$API_URL/health" 2>/dev/null)
    local http_code=$(echo "$response" | tail -1)
    local body=$(echo "$response" | head -n -1)
    
    if [ "$http_code" = "200" ]; then
        local status=$(echo "$body" | jq -r '.status' 2>/dev/null)
        if [ "$status" = "ok" ]; then
            log "API is healthy"
            return 0
        else
            err "API returned unexpected status: $status"
            send_alert "API returned unexpected status: $status" "warning"
            return 1
        fi
    else
        err "API health check failed (HTTP $http_code)"
        send_alert "API is down (HTTP $http_code)" "critical"
        return 1
    fi
}

# Check response time
check_latency() {
    log "Checking API latency..."
    
    local start=$(date +%s%N)
    curl -s -o /dev/null -w "%{time_total}" "$API_URL/health" > /dev/null 2>&1
    local end=$(date +%s%N)
    local duration=$(( (end - start) / 1000000 ))
    
    if [ $duration -lt 1000 ]; then
        log "Latency: ${duration}ms (good)"
    elif [ $duration -lt 3000 ]; then
        warn "Latency: ${duration}ms (slow)"
    else
        err "Latency: ${duration}ms (too slow)"
        send_alert "High latency: ${duration}ms" "warning"
    fi
}

# Check database (if configured)
check_database() {
    log "Checking database..."
    
    # Try to connect via Supabase
    local result=$(curl -s "$API_URL/api/debug" 2>/dev/null)
    local supabase=$(echo "$result" | jq -r '.supabase' 2>/dev/null)
    
    if [ "$supabase" = "true" ]; then
        log "Database is configured"
    elif [ "$supabase" = "false" ]; then
        warn "Database not configured (demo mode)"
    else
        err "Could not determine database status"
    fi
}

# Check Stripe
check_stripe() {
    log "Checking Stripe..."
    
    local result=$(curl -s "$API_URL/api/debug" 2>/dev/null)
    local stripe=$(echo "$result" | jq -r '.stripe' 2>/dev/null)
    
    if [ "$stripe" = "true" ]; then
        log "Stripe is configured"
    elif [ "$stripe" = "false" ]; then
        warn "Stripe not configured (demo mode)"
    else
        err "Could not determine Stripe status"
    fi
}

# Generate report
generate_report() {
    local report=$(cat << EOF
🦞 Poniente Status Report
========================
Generated: $(date '+%Y-%m-%d %H:%M:%S')

API Status: $(check_api > /dev/null 2>&1 && echo "✅ Healthy" || echo "❌ Down")
Latency: ${duration:-unknown}ms
Database: $(echo "$result" | jq -r '.supabase' 2>/dev/null || echo "unknown")
Stripe: $(echo "$result" | jq -r '.stripe' 2>/dev/null || echo "unknown")

Uptime: $(uptime | grep -o 'load averages.*' || echo "unknown")
Memory: $(ps -o pid,pmem,comm -p $$ 2>/dev/null | tail -1 || echo "unknown")
EOF
)
    
    echo "$report"
    echo "$report" >> "$LOG_FILE"
}

# Main
main() {
    log "Starting Poniente monitoring..."
    
    # Run checks
    check_api
    check_latency
    check_database
    check_stripe
    
    # Generate report
    generate_report
    
    log "Monitoring check complete"
}

# Run
case "${1:-all}" in
    api) check_api ;;
    latency) check_latency ;;
    db) check_database ;;
    stripe) check_stripe ;;
    report) generate_report ;;
    all) main ;;
    *) echo "Usage: $0 {api|latency|db|stripe|report|all}" ;;
esac
