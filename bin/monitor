#!/bin/bash
# Poniente Monitoring - Health checks and alerts

set -e

API_URL="https://api-gilt-xi-28.vercel.app"
LOG_FILE="${LOG_FILE:-$HOME/.poniente/monitor.log}"

log() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" | tee -a "$LOG_FILE"; }
warn() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [WARN] $1" | tee -a "$LOG_FILE"; }
err() { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" | tee -a "$LOG_FILE"; }

mkdir -p "$(dirname "$LOG_FILE")"

check_api() {
    log "Checking API health..."
    local http_code=$(curl -s -o /dev/null -w "%{http_code}" "$API_URL/health")
    if [ "$http_code" = "200" ]; then
        log "API is healthy (HTTP $http_code)"
        return 0
    else
        err "API health check failed (HTTP $http_code)"
        return 1
    fi
}

check_debug() {
    log "Checking debug endpoint..."
    curl -s "$API_URL/api/debug" 2>/dev/null | head -c 200
    echo ""
}

check_latency() {
    log "Checking latency..."
    local time=$(curl -s -o /dev/null -w "%{time_total}" "$API_URL/health")
    echo "Latency: ${time}s"
}

main() {
    log "Starting Poniente monitoring..."
    check_api
    check_latency
    check_debug
    log "Monitoring check complete"
}

case "${1:-all}" in
    api) check_api ;;
    latency) check_latency ;;
    debug) check_debug ;;
    all) main ;;
    *) echo "Usage: $0 {api|latency|debug|all}" ;;
esac
